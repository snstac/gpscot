#!/bin/sh
set -e

systemctl disable --now gpstak.service >/dev/null 2>&1 || true
if [ -f /etc/default/gpstak ]; then
  sed 's/GPSTAK/GPSCOT/g; s/gpstak/gpscot/g' \
    /etc/default/gpstak > /etc/default/gpscot
  chmod 0644 /etc/default/gpscot
  mv /etc/default/gpstak /etc/default/gpstak.migrated
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi

exit 0
