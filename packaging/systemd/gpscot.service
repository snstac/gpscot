[Unit]
Description=GPSCOT: Network GPS for TAK (feed onboard GNSS to ATAK/WinTAK)
Documentation=https://ampledata.org/network_gps.html
After=network-online.target gpsd.service
Wants=network-online.target gpsd.service

[Service]
Type=simple
EnvironmentFile=-/etc/aryaos/aryaos-config.txt
EnvironmentFile=-/etc/default/gpscot
ExecStart=/usr/local/bin/gpscot
Restart=on-failure
RestartSec=5
DynamicUser=yes
SyslogIdentifier=gpscot
# Creates /run/gpscot for pytak's StatusWriter. Without this the status
# file has nowhere to go under DynamicUser= (/run is not writable), and
# every write fails silently into the write_errors counter.
RuntimeDirectory=gpscot

[Install]
WantedBy=multi-user.target
